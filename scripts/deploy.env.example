# Copy this to ~/.config/kvguzzler/deploy.env (outside the repository) and fill it in. That file is read by
# scripts/deploy-server.sh. Nothing site-specific is kept in the repo; this example holds placeholders only.
#
# Where the box is: an SSH user with passwordless sudo, and the box's address on your network.
DEPLOY_TARGET=user@192.0.2.10
# The port the server answers on (used for the health check after a deploy).
DEPLOY_PORT=8080

# Server settings, written to /etc/housed/housed.env on the box by `deploy-server.sh --env`. Leave a line out to use the
# server's own default. HOUSED_TZ decides which calendar day a bill or a "day" bucket belongs to.
HOUSED_TZ=America/Chicago
#HOUSED_LISTEN=:8080
#HOUSED_DATA=/var/lib/housed
