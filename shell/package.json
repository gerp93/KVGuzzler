{
  "name": "kvguzzler-house-viewer",
  "version": "0.1.0",
  "description": "The installed viewer for the KVGuzzler house server: a window that loads the dashboard the server serves.",
  "main": "dist/main.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "gerp93",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-pages.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.gerp93.kvguzzler.house",
    "productName": "House Power",
    "artifactName": "House-Power-Setup-${version}.${ext}",
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
